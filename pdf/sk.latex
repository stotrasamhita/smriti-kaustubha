%% Smṛti-kaustubha print template (spec §7). Filled by pandoc from build/pdf/text.md; see pdf/README.md.
\documentclass[10pt,twoside,openany]{book}
\usepackage[paperwidth=176mm,paperheight=250mm,inner=20mm,outer=34mm,top=22mm,bottom=24mm,
  marginparwidth=20mm,marginparsep=4mm]{geometry}
\usepackage{fontspec}
\usepackage{xcolor}
\usepackage{fancyhdr}
\usepackage{longtable}
\usepackage[para]{manyfoot}
\usepackage{enumitem}
\usepackage[hidelinks,unicode]{hyperref}
\usepackage{bookmark}

%% Fonts: Tiro Devanagari Sanskrit when installed (spec §7), else Noto Serif Devanagari.
%% Latin and IAST fall back to Noto Serif. HarfBuzz shapes the conjuncts.
\directlua{luaotfload.add_fallback("skfallback", {"NotoSerif:mode=harf;", "NotoSerifDevanagari:mode=harf;script=dev2;"})}
\IfFontExistsTF{Tiro Devanagari Sanskrit}
  {\def\skdevafont{Tiro Devanagari Sanskrit}}
  {\def\skdevafont{Noto Serif Devanagari}}
\def\skscript{$script$}
\def\skdev{devanagari}
\ifx\skscript\skdev
  \setmainfont{\skdevafont}[Renderer=HarfBuzz,Script=Devanagari,RawFeature={fallback=skfallback}]
\else
  \setmainfont{Noto Serif}[Renderer=HarfBuzz,RawFeature={fallback=skfallback}]
\fi
\newfontfamily\latinfont{Noto Serif}[Renderer=HarfBuzz]
\linespread{1.15}
\setlength{\parindent}{1.5em}
\setlength{\emergencystretch}{3em}
\tolerance=2000
\raggedbottom
\makeatletter  % no running head on the blank pages left by \cleardoublepage
\renewcommand{\cleardoublepage}{\clearpage\if@twoside\ifodd\c@page\else\hbox{}\thispagestyle{empty}\newpage\fi\fi}
\makeatother

%% Two modes. Reading copy (default): corrected text only. Every correction stays in this .tex as
%% \skcorr{printed}{OCR reading}, every doubt as \skdoubt, and all are listed in <name>-corrections.tsv.
%% Draft (`build_pdf.py --draft`): apparatus series A gives "lemma ] OCR reading", doubts show as red [?].
%% 1931 footnotes are ordinary \footnote in both modes; series B (Kāśī variant readings) likewise.
\DeclareNewFootnote[para]{A}
\DeclareNewFootnote[para]{B}
\renewcommand{\thefootnoteA}{}
\renewcommand{\thefootnoteB}{}
\newcommand{\sklemma}[1]{#1\,]}
\newcommand{\skvar}[1]{\FootnotetextB{}{#1\enspace}}
\newcommand{\skq}[2]{#2}
$if(draft)$
\newcommand{\skcorr}[2]{#1\FootnotetextA{}{\sklemma{#1} {\latinfont\footnotesize\itshape OCR} \ifx\relax#2\relax{\latinfont\footnotesize\itshape om.}\else#2\fi\enspace}}
\newcommand{\skem}[2]{#1\FootnotetextA{}{\sklemma{#1} {\latinfont\footnotesize\itshape 1931} #2\enspace}}
\newcommand{\skdoubt}{\textsuperscript{\textcolor{red!70!black}{\latinfont[?]}}}
\newcommand{\skmeta}[1]{{\centering\latinfont\scriptsize\textcolor{black!55}{#1}\par}}
$else$
\newcommand{\skcorr}[2]{#1}
\newcommand{\skem}[2]{#1}
\newcommand{\skdoubt}{}
\newcommand{\skmeta}[1]{}
$endif$
\newcommand{\skindent}{\hspace*{2em}}

%% 1931 page numbers in the outer margin at the exact break ("|87").
\newcommand{\skpg}[1]{\hypertarget{p#1}{}\textcolor{black!45}{\textbar}\marginpar{\raggedright\latinfont\footnotesize\textcolor{black!60}{|#1}}}
\newcommand{\skmn}[1]{\marginpar{\raggedright\footnotesize\color{black!75}#1}}
\newcommand{\skpara}[1]{\hypertarget{#1}{}}
\newenvironment{skshloka}[1]
  {\par\hypertarget{#1}{}\begin{list}{}{\leftmargin=2.5em\rightmargin=0pt\topsep=.5\baselineskip}\item[]\raggedright}
  {\end{list}\par}

%% Running heads: left, the dīdhiti; right, the current topic. Page numbers of this edition outside.
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small संवत्सरदीधितिः}
\fancyhead[RO]{\small\rightmark}
\fancyhead[LO,RE]{\latinfont\small\thepage}
\renewcommand{\headrulewidth}{0.3pt}
\newcommand{\sktopic}[4]{%
  \par\bigskip\hypertarget{#1}{}%
  \begin{center}\Large\href{#2}{#4}\end{center}\nopagebreak
  \addcontentsline{toc}{section}{#4}\markright{#4}%
  \pdfbookmark[1]{#4}{#1}%
  \skmeta{#1 · #3 · \url{#2}}\nopagebreak\medskip}
\newcommand{\sksection}[1]{\cleardoublepage\begin{center}\huge #1\end{center}\addcontentsline{toc}{chapter}{#1}%
  \pdfbookmark[0]{#1}{#1}\bigskip}

\newcommand{\skindices}{\cleardoublepage\markright{सूच्यः · Indices}\section*{सूच्यः \latinfont\normalsize · Indices}
  \addcontentsline{toc}{section}{सूच्यः · Indices}{\latinfont\small Page numbers are those of the 1931 edition.\par}}
\newcommand{\skindex}[2]{\subsection*{#1 {\latinfont\normalsize· #2}}\addcontentsline{toc}{subsection}{#1 · #2}}
\newenvironment{skindexlist}{\begin{itemize}[label={},leftmargin=1em,itemindent=-1em,itemsep=0pt,parsep=0pt]\small}{\end{itemize}}
\newenvironment{skconcordance}
  {\small\begin{longtable}{@{}r r l@{}}\latinfont 1931 p. & \latinfont scan & \latinfont web\\\hline\endhead}
  {\end{longtable}}

\hypersetup{pdftitle={Smṛtikaustubha: $section-title$ (pp.$pages$)},pdfauthor={Anantadeva; digital edition, stotrasamhita},
  pdflang={sa}}

\begin{document}
\frontmatter
\pagestyle{empty}
\begin{center}
  \vspace*{30mm}
  {\Huge स्मृतिकौस्तुभः}\par\bigskip
  {\Large अनन्तदेवप्रणीतः}\par\bigskip
  {\large संवत्सरदीधितिः · $section-title$}\par\vfill
  {\latinfont
  Nirṇaya Sāgara Press, Bombay, 2nd ed., 1931, printed pp.\,$pages$\par\medskip
  Digital edition · Phase~0 pilot · \today\par\medskip
  $if(draft)$\textcolor{red!70!black}{Proof copy with OCR apparatus. Not yet proof-read against the page images.}$else$Draft for comment. The text is corrected from OCR but not yet proof-read against the page images.$endif$\par}
\end{center}
\cleardoublepage
{\latinfont\small
\section*{Conventions}
\begin{itemize}[leftmargin=1.2em]
\item Numbers in the outer margin (|87) are the page numbers of the 1931 edition; a grey bar marks the exact break.
  Side-headings printed in the 1931 margins are also set in the margin.
\item Footnotes numbered 1, 2, 3 are the 1931 edition's own notes (mostly readings of other manuscripts, \emph{iti pāṭhaḥ}).
$if(draft)$
\item Unnumbered notes in the first apparatus give the OCR reading for every word we corrected: \emph{lemma\,] OCR reading}.
  These corrections were made from context; each must still be checked against the page images.
\item A red [?] marks a doubtful reading to be checked against the page image.
$else$
\item Obvious OCR errors have been corrected silently; the list of corrections, and of readings still in doubt,
  is kept with the source files and printed in the proof copy.
$endif$
\item Headings link to the web edition, where every paragraph has a stable anchor (e.g. \#p87.1).
\end{itemize}
}
\cleardoublepage
\pagestyle{fancy}
\renewcommand{\contentsname}{विषयानुक्रमः}
\tableofcontents
\mainmatter
\cleardoublepage
$body$
$for(include-after)$
